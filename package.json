{
  "name": "justd-vite",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_ENV=production react-router build",
    "dev": "react-router dev",
    "start": "cross-env NODE_ENV=production react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "format": "biome lint --fix ./app && biome check --write ./app",
    "format:unsafe": "biome check --unsafe --write"
  },
  "dependencies": {
    "@intentui/icons": "^1.11.3",
    "@react-router/node": "^7.18.4",
    "@react-router/serve": "^7.18.4",
    "cn": "^0.4.0",
    "isbot": "^5.2.2",
    "motion": "^12.43.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.18.4",
    "sonner": "^2.0.8",
    "tailwind-variants": "^1.0.0",
    "tailwindcss-react-aria-components": "^2.2.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@react-router/dev": "^7.18.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^7.0.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vite-tsconfig-paths": "^5.1.4"
  }
